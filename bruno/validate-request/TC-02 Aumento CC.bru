meta {
  name: TC-02 Aumento CC
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/loans/req-mgr/external/v1/product/2/request/validate-request
  body: json
  auth: none
}

headers {
  authorization: {{token}}
  content-type: application/json
}

body:json {
  {
    "documento": {
      "tipo": "CO1N",
      "numero": "52966724"
    },
    "canalOrigen": "WEB",
    "tipoSolicitud": "2"
  }
}

assert {
  res.status: eq 200
}

docs {
  Happy Path — Novedad Aumento CC.
  tipoSolicitud=2 debe enrutar al subproceso de aumento en Bizagi.
  Expected: 200 OK (o 409 si ya tiene novedad activa)
}

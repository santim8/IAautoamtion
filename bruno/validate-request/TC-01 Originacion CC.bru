meta {
  name: TC-01 Originacion CC
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/loans/req-mgr/external/v1/product/2/request/validate-request
  body: json
  auth: none
}

headers {
  authorization: {{token}}
  content-type: application/json
}

body:json {
  {
    "documento": {
      "tipo": "CO1C",
      "numero": "1095915781"
    },
    "canalOrigen": "WEB",
    "tipoSolicitud": "1"
  }
}

assert {
  res.status: eq 200
}

docs {
  Happy Path — Originación CC sin caso previo en Bizagi.
  tipoSolicitud=1 debe habilitar la creación del caso.
  Expected: 200 OK
}

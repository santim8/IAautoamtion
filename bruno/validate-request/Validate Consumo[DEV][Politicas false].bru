  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "documento": {
      "tipo": "CO1C",
      "numero": ""
    },
    "canalOrigen": "WEB",
    "grupoProducto": "CONSUMO",

meta {
  name: TC-04 Case In Progress
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/loans/req-mgr/external/v1/product/2/request/validate-request
  body: json
  auth: none
}

headers {
  authorization: {{token}}
  content-type: application/json
}

body:json {
  {
    "documento": {
      "tipo": "CO1E",
      "numero": "648202"
    },
    "canalOrigen": "WEB",
    "tipoSolicitud": "1"
  }
}

assert {
  res.status: eq 409
  res.body.errores[0].codigoError: eq LRMGR00017
  res.body.errores[0].detalle: eq CASE_IN_PROGRESS
}

docs {
  Negativo — Documento CE 648202 con caso activo en Bizagi.
  El servicio debe rechazar la solicitud con 409 CASE_IN_PROGRESS.
  EVIDENCIA CONFIRMADA: 409 LRMGR00017 CASE_IN_PROGRESS ✅

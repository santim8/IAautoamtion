meta {
  name: TC-03 Reactivacion CC
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/loans/req-mgr/external/v1/product/2/request/validate-request
  body: json
  auth: none
}

headers {
  authorization: {{token}}
  content-type: application/json
}

body:json {
  {
    "documento": {
      "tipo": "CO1N",
      "numero": "1097397286"
    },
    "canalOrigen": "WEB",
    "tipoSolicitud": "3"
  }
}

assert {
  res.status: eq 200
}

docs {
  Happy Path — Novedad Reactivación CC.
  tipoSolicitud=3 debe enrutar al subproceso de reactivación en Bizagi.
  Expected: 200 OK (o 409 si ya tiene novedad activa)
}

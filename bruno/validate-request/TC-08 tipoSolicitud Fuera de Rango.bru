meta {
  name: TC-08 tipoSolicitud Fuera de Rango
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/loans/req-mgr/external/v1/product/2/request/validate-request
  body: json
  auth: none
}

headers {
  authorization: {{token}}
  content-type: application/json
}

body:json {
  {
    "documento": {
      "tipo": "CO1N",
      "numero": "1095915781"
    },
    "canalOrigen": "WEB",
    "tipoSolicitud": "9"
  }
}

assert {
  res.status: in [400, 422]
}

docs {
  Negativo — tipoSolicitud con valor fuera del rango permitido (1, 2, 3).
  Criterio historia CA2: tipado numérico debe coincidir con validaciones de req-mgr.
  Expected: 400 Bad Request o 422 Unprocessable Entity.
}

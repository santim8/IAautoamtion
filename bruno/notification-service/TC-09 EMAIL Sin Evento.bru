meta {
  name: TC-09 EMAIL Sin Evento
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}{{emailPath}}
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  content-type: application/json
}

body:json {
  {
    "adjuntos": [],
    "datos": {
      "diaDePago": "1",
      "fechaHoraSolicitud": "2026-05-22T16:38:48.00000",
      "numeroTarjetaMultiservicios": "8800010305054110",
      "tipoCuota": "FIJA",
      "valorCuota": 75000.0000,
      "valorCupo": 1500000.0000
    },
    "destinatario": {
      "email": "{{emailDestinatario}}",
      "primerApellido": "CASTAÑO",
      "primerNombre": "DAVID"
    },
    "documento": {
      "numero": "80229110",
      "tipo": "CO1C"
    }
  }
}

assert {
  res.status: eq 400
}

docs {
  Negativo E2 — Falta el campo "evento".
  Esperado: 400 Bad Request con mensaje claro indicando campo faltante.
  Validar: NO se consume la API de Infobip (no aparece llamada en logs).
}

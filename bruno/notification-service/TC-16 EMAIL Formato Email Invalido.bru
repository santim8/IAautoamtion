meta {
  name: TC-16 EMAIL Formato Email Invalido
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}{{emailPath}}
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  content-type: application/json
}

body:json {
  {
    "adjuntos": [],
    "datos": {
      "diaDePago": "1",
      "fechaHoraSolicitud": "2026-05-22T16:38:48.00000",
      "numeroTarjetaMultiservicios": "8800010305054110",
      "tipoCuota": "FIJA",
      "valorCuota": 75000.0000,
      "valorCupo": 1500000.0000
    },
    "destinatario": {
      "email": "correo-sin-arroba-ni-dominio",
      "primerApellido": "CASTAÑO",
      "primerNombre": "DAVID"
    },
    "documento": {
      "numero": "80229110",
      "tipo": "CO1C"
    },
    "evento": "CUPO_CREDITO_RECHAZADO"
  }
}

assert {
  res.status: eq 400
}

docs {
  Negativo E2 — Email con formato inválido (sin @, sin dominio).
  Esperado: 400 si el servicio valida formato; alternativamente 200 si solo lo pasa a Infobip.
  ⚠️ CONFIRMAR con BE: ¿el servicio valida formato o solo lo reenvía?
  Si reenvía: ajustar este TC a E3 (esperar error de Infobip).
}

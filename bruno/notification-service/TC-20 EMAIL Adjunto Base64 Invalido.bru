meta {
  name: TC-20 EMAIL Adjunto Base64 Invalido
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}{{emailPath}}
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  content-type: application/json
}

body:json {
  {
    "adjuntos": [
      {
        "contenido": "esto-no-es-base64-valido!!!",
        "nombreArchivo": "archivo_invalido.pdf",
        "tipo": "base64"
      }
    ],
    "datos": {
      "diaDePago": "1",
      "fechaHoraSolicitud": "2026-05-22T16:38:48.00000",
      "numeroTarjetaMultiservicios": "8800010305054110",
      "tipoCuota": "FIJA",
      "valorCuota": 130000.0000,
      "valorCupo": 2600000.0000
    },
    "destinatario": {
      "email": "{{emailDestinatario}}",
      "primerApellido": "CASTAÑO",
      "primerNombre": "DAVID"
    },
    "documento": {
      "numero": "80229110",
      "tipo": "CO1C"
    },
    "evento": "CUPO_CREDITO_APROBADO"
  }
}

assert {
  res.status: eq 400
}

docs {
  Negativo E2 — Adjunto con contenido base64 corrupto / inválido.
  Esperado: 400 con mensaje claro sobre adjunto inválido.
  Alternativa: si el servicio reenvía a Infobip, podría devolver E3 (error de Infobip).
  ⚠️ CONFIRMAR comportamiento esperado con BE.
}

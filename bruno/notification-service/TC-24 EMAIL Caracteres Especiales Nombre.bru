meta {
  name: TC-24 EMAIL Caracteres Especiales Nombre
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}{{emailPath}}
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  content-type: application/json
}

body:json {
  {
    "adjuntos": [],
    "datos": {
      "diaDePago": "1",
      "fechaHoraSolicitud": "2026-05-22T16:38:48.00000",
      "numeroTarjetaMultiservicios": "8800010305054110",
      "tipoCuota": "FIJA",
      "valorCuota": 75000.0000,
      "valorCupo": 1500000.0000
    },
    "destinatario": {
      "email": "{{emailDestinatario}}",
      "primerApellido": "MUÑOZ DE LA ROSA",
      "primerNombre": "JOSÉ MARÍA"
    },
    "documento": {
      "numero": "80229110",
      "tipo": "CO1C"
    },
    "evento": "CUPO_CREDITO_RECHAZADO"
  }
}

assert {
  res.status: eq 200
}

docs {
  Edge case — Caracteres especiales en nombres.
  Probar: tildes (José, María), Ñ (Muñoz), apellidos compuestos (De la Rosa).
  Esperado en el correo:
    - Caracteres se renderizan correctamente (no como ? o entidades HTML).
    - Capitalización aplicada: "José María Muñoz De La Rosa" (o variante según regla de PO).
  Validación visual en buzón.
}

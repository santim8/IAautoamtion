meta {
  name: TC-23 EMAIL Capitalizacion Nombre
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}{{emailPath}}
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  content-type: application/json
}

body:json {
  {
    "adjuntos": [],
    "datos": {
      "diaDePago": "1",
      "fechaHoraSolicitud": "2026-05-22T16:38:48.00000",
      "numeroTarjetaMultiservicios": "8800010305054110",
      "tipoCuota": "FIJA",
      "valorCuota": 75000.0000,
      "valorCupo": 1500000.0000
    },
    "destinatario": {
      "email": "{{emailDestinatario}}",
      "primerApellido": "RODRIGUEZ",
      "primerNombre": "MARIA FERNANDA"
    },
    "documento": {
      "numero": "80229110",
      "tipo": "CO1C"
    },
    "evento": "CUPO_CREDITO_RECHAZADO"
  }
}

assert {
  res.status: eq 200
}

docs {
  Regla de negocio (TASK 203063) — Capitalización del nombre.
  Envío con nombre en MAYÚSCULAS: "MARIA FERNANDA" / "RODRIGUEZ".
  Esperado en el correo recibido:
    - Primera letra mayúscula, resto minúsculas: "Maria Fernanda Rodriguez".
    - Si es nombre compuesto, cada palabra debería capitalizar (confirmar con PO).
  Esta validación es VISUAL en el buzón — no se puede asertar por response code.
}

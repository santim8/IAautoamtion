meta {
  name: TC-21 EMAIL Adjunto Sin nombreArchivo
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}{{emailPath}}
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  content-type: application/json
}

body:json {
  {
    "adjuntos": [
      {
        "contenido": "data:application/pdf;base64,JVBERi0xLjQKJeLjz9MKMyAwIG9iago8PC9GaWx0ZXIvRmxhdGVEZWNvZGUvTGVuZ3RoIDQ0Pj5zdHJlYW0KeJwzUvDiMlAwUjBQsLHhcgkN9wxxNQTzgkM9I50UFAyAOACSiAfXCmVuZHN0cmVhbQplbmRvYmoK",
        "tipo": "base64"
      }
    ],
    "datos": {
      "diaDePago": "1",
      "fechaHoraSolicitud": "2026-05-22T16:38:48.00000",
      "numeroTarjetaMultiservicios": "8800010305054110",
      "tipoCuota": "FIJA",
      "valorCuota": 130000.0000,
      "valorCupo": 2600000.0000
    },
    "destinatario": {
      "email": "{{emailDestinatario}}",
      "primerApellido": "CASTAÑO",
      "primerNombre": "DAVID"

meta {
  name: TC-02 EMAIL CUPO_CREDITO_RECHAZADO
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}{{emailPath}}
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  content-type: application/json
}

body:json {
  {
    "adjuntos": [],
    "datos": {
      "diaDePago": "1",
      "fechaHoraSolicitud": "2026-05-22T16:38:48.00000",
      "numeroTarjetaMultiservicios": "8800010305054110",
      "tipoCuota": "FIJA",
      "valorCuota": 75000.0000,
      "valorCupo": 1500000.0000
    },
    "destinatario": {
      "email": "{{emailDestinatario}}",
      "primerApellido": "CASTAÑO",
      "primerNombre": "DAVID"
    },
    "documento": {
      "numero": "80229110",
      "tipo": "CO1C"
    },
    "evento": "CUPO_CREDITO_RECHAZADO"
  }
}

assert {
  res.status: eq 200
}

docs {
  Happy Path — Negación de solicitud de crédito.
  Evento mapeado a templateId Infobip 405000000003537.
  Adjuntos vacíos: lista debe ser [] (no null, no faltar).
  Validar en buzón:
    - Mensaje de rechazo por políticas financieras.
    - Invitación a explorar otros servicios.
    - Nombre renderizado como "David Castaño".
}

meta {
  name: TC-12 EMAIL Sin documento.numero
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}{{emailPath}}
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  content-type: application/json
}

body:json {
  {
    "adjuntos": [],
    "datos": {
      "diaDePago": "1",
      "fechaHoraSolicitud": "2026-05-22T16:38:48.00000",
      "numeroTarjetaMultiservicios": "8800010305054110",
      "tipoCuota": "FIJA",
      "valorCuota": 75000.0000,
      "valorCupo": 1500000.0000
    },
    "destinatario": {
      "email": "{{emailDestinatario}}",
      "primerApellido": "CASTAÑO",
      "primerNombre": "DAVID"
    },
    "documento": {
      "tipo": "CO1C"
    },
    "evento": "CUPO_CREDITO_RECHAZADO"
  }
}

assert {
  res.status: eq 400
}

docs {
  Negativo E2 — Falta documento.numero.
  Esperado: 400. El número de documento es clave para trazabilidad.
}

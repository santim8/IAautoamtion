      "email": "{{emailDestinatario}}",
      "primerApellido": "RODRIGUEZ",
      "primerNombre": "MARIA FERNANDA"
    },
    "documento": {
      "numero": "80229110",
      "tipo": "CO1C"
    },
    "evento": "CUPO_CREDITO_RECHAZADO"
  }
}

assert {
  res.status: eq 200
}

docs {
  Test de capitalización para CUPO_CREDITO_RECHAZADO (templateId 405000000003537).

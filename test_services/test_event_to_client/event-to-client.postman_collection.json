      "item": [
        {
          "name": "VALIDATION INVALID_USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Estado aceptado por el servicio\", () => pm.expect(b.enviarEventoCliente, \"sin enviarEventoCliente: el ambiente no conoce el estado\").to.be.an(\"object\"));",
                  "const id = [pm.collectionVariables.get(\"idProducto\"), pm.collectionVariables.get(\"tipoDocumento\"), pm.collectionVariables.get(\"numeroDocumento\")].join(\"_\");",
                  "const entregado = b.enviarEventoCliente && b.enviarEventoCliente.estado === \"OK\";",
                  "console.log((entregado ? \"Entregado al socket \" : \"Aceptado, sin socket abierto para \") + id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
